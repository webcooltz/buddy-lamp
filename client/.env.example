# Copy to .env (install.sh does this for you). Never commit .env.

# Server messages URL, including /messages
BUDDY_LAMP_URL=https://your-server.example.com/messages

# Family group. Lamps with the same family share one color; other families never see it.
# 1-32 characters: a-z, 0-9, - or _
BUDDY_LAMP_FAMILY=johnson-family

# Shared password. Must match BUDDY_LAMP_SECRET in the server's .env
BUDDY_LAMP_SECRET=change-me-to-something-long

# This lamp: who you are (max 32 characters) and the color you send: red, blue or green
BUDDY_LAMP_NAME=Johnson
BUDDY_LAMP_COLOR=red

# Optional wiring (GPIO/BCM numbers). Defaults shown.
# The "mine" LED must be the one that matches your color (red LED for red, blue LED for blue).
# BUDDY_LAMP_BUTTON_PIN=2
# BUDDY_LAMP_MINE_LED_PIN=3
# BUDDY_LAMP_OTHER_LED_PIN=17
